# Copy to .env and fill in. Never commit .env.

# Qualcomm Cloud AI Playground: key from https://aisuite.cirrascale.com/api-keys
QUALCOMM_API_KEY=
QUALCOMM_ENDPOINT=https://aisuite.cirrascale.com/apis/v2
QUALCOMM_MODEL=Llama-3.1-8B
# Set these from the result of scripts/check_qualcomm.py
QUALCOMM_CLIENT=imagine
QUALCOMM_STRUCTURED_MODE=json

# Shared secret between the Next.js server and FastAPI (any long random string)
INTERNAL_API_TOKEN=

# Resend: key from https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=Decision OS <onboarding@resend.dev>
# Free tier delivers only to your own Resend account email until you verify a domain.
# Put that address here and every demo email is delivered to it.
EMAIL_OVERRIDE_TO=
APP_URL=http://localhost:3000

SCHEDULER_ENABLED=true
SCHEDULER_MINUTES=60
APP_TIMEZONE=Asia/Kolkata
